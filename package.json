{
  "name": "sanoj-kumar-academic-portfolio",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vinext dev",
    "build": "node scripts/patch-scholarresume-pdf.mjs && vinext build && node scripts/prerender.mjs",
    "start": "vinext start",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:vision": "node --test tests/smart-vision.test.mjs",
    "lint": "eslint . --ignore-pattern dist --ignore-pattern .next",
    "db:generate": "drizzle-kit generate",
    "deploy:firebase": "npm run build && firebase deploy --only hosting",
    "docker:up": "docker compose up --build -d portfolio",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f portfolio",
    "docker:dev": "docker compose --profile dev up --build portfolio-dev"
  },
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "firebase": "^12.17.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^1.28.0",
    "next": "16.2.6",
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "react-icons": "^5.7.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "1.37.1",
    "@tailwindcss/postcss": "4.2.1",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "@vitejs/plugin-rsc": "0.5.26",
    "drizzle-kit": "0.31.10",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.6",
    "react-server-dom-webpack": "19.2.6",
    "tailwindcss": "4.2.1",
    "typescript": "5.9.3",
    "vinext": "0.0.50",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
